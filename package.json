{
  "name": "nse-paper-trading",
  "private": true,
  "version": "1.0.0",
  "description": "Broker-style paper trading platform for NSE stocks",
  "workspaces": [
    "packages/shared",
    "packages/core",
    "apps/api",
    "apps/worker",
    "apps/web"
  ],
  "scripts": {
    "build": "tsc -b apps/api apps/worker",
    "typecheck": "tsc -b apps/api apps/worker && npm run typecheck -w apps/web",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects core-unit",
    "migrate": "npm run migrate -w packages/core",
    "seed": "npm run seed -w packages/core",
    "dev:api": "npm run dev -w apps/api",
    "dev:worker": "npm run dev -w apps/worker",
    "dev:web": "npm run dev -w apps/web"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "5.8",
    "typescript-eslint": "^8.72.0"
  }
}
