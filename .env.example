# ---- Copy to .env and adjust. Never commit real secrets. ----
NODE_ENV=development
LOG_LEVEL=info

# Postgres / Redis
DATABASE_URL=postgres://trader:trader@localhost:5432/trading
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379/0

# Auth: generate with `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10

# Market data: "yahoo" for real NSE prices, "fake" for an offline deterministic market
MARKET_DATA_PROVIDER=yahoo
QUOTE_CACHE_TTL_SECONDS=15
QUOTE_POLL_INTERVAL_MS=5000

# Trading
STARTING_CASH=1000000
# queue = API publishes to BullMQ and the worker executes; sync = execute in the API process
EXECUTION_MODE=queue
# EOD job (Asia/Kolkata): ingest prices and sweep limit orders after NSE close
EOD_CRON=0 16 * * 1-5

# API
PORT=4000
CORS_ORIGINS=http://localhost:5173

# Test databases (used by `npm test`)
TEST_DATABASE_URL=postgres://trader:trader@localhost:5432/trading_test
TEST_REDIS_URL=redis://localhost:6379/15

# Rate limits (fixed 60s window, stored in Redis)
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_ORDERS_PER_MIN=120
