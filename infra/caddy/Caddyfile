# Caddy obtains and renews a Let's Encrypt certificate for this domain automatically.
# API_DOMAIN comes from the environment (docker-compose.prod.yml), e.g. api.example.com
{$API_DOMAIN} {
	encode zstd gzip

	# WebSocket upgrade is handled transparently by reverse_proxy.
	reverse_proxy api:4000 {
		header_up X-Request-Id {http.request.header.X-Request-Id}
		health_uri /health
		health_interval 15s
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output stdout
		format json
	}
}
